/////////////////////////////////////////////////////////////////////////////
//
// 图标
//

IDI_STRIKESENSE       ICON         "StrikeSense.ico"
IDI_SMALL             ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// 菜单
//

IDC_STRIKESENSE MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "创建 GSI 配置文件(&G)...",  IDM_CREATE_GSI_CFG
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                IDM_EXIT
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "Debugger(&D)",            IDM_DEBUGGER
        MENUITEM SEPARATOR
        MENUITEM "关于(&A) ...",            IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// 快捷键
//

IDC_STRIKESENSE ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


