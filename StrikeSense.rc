// 关于对话框
IDD_ABOUTBOX DIALOGEX 0, 0, 280, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 StrikeSense"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDI_STRIKESENSE,IDC_STATIC,14,14,21,20
    LTEXT           "StrikeSense",IDC_STATIC,42,8,100,8,SS_NOPREFIX
    LTEXT           "测试发布版 202607171405",IDC_STATIC,42,20,140,8
    LTEXT           "Copyright (C) 2026 无损平方集团",IDC_STATIC,42,32,160,8
    LTEXT           "本程序承诺绝不联网，所以无法检查更新",IDC_STATIC,14,50,250,16
    LTEXT           "永不联网 | 绝对无毒 | 数据安全 | 快速好用",IDC_STATIC,14,66,250,12
    DEFPUSHBUTTON   "确定",IDOK,115,88,50,14,WS_GROUP
END

// Debugger 调试输出窗口
IDD_DEBUGGER DIALOGEX 0, 0, 480, 360
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Debugger 调试输出"
FONT 9, "微软雅黑", 400, 0, 0x80
BEGIN
    EDITTEXT        IDC_DEBUG_EDIT, 8, 8, 464, 304, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "清除", IDC_COPYALL, 380, 320, 70, 24, BS_PUSHBUTTON | WS_TABSTOP
    PUSHBUTTON      "关闭", IDOK, 8, 320, 70, 24, BS_PUSHBUTTON | WS_TABSTOP
END

// GSI 配置路径确认对话框
IDD_CONFIRM_PATH DIALOGEX 0, 0, 450, 215
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "确认 GSI 配置文件路径"
FONT 9, "微软雅黑", 400, 0, 0x80
BEGIN
    LTEXT           "CS2 游戏配置目录路径：",IDC_STATIC,12,12,300,12
    EDITTEXT        IDC_PATH_LABEL,12,28,426,20, ES_READONLY | ES_AUTOHSCROLL | ES_LEFT
    LTEXT           "是否将 GSI 配置文件安装到此目录？",IDC_STATIC,12,58,300,12
    DEFPUSHBUTTON   "是(&Y)", IDYES, 30, 85, 90, 25, WS_TABSTOP
    PUSHBUTTON      "浏览...(&B)", IDC_BROWSE_BTN, 140, 85, 90, 25, WS_TABSTOP
    PUSHBUTTON      "删除已安装文件(&D)", IDC_DELETE_CFG, 250, 85, 100, 25, WS_TABSTOP
    PUSHBUTTON      "取消(&C)", IDCANCEL, 360, 85, 70, 25, WS_TABSTOP
END

// 设置对话框
IDD_SETTINGS DIALOGEX 0, 0, 350, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "StrikeSense 设置"
FONT 9, "微软雅黑", 400, 0, 0x80
BEGIN
    CONTROL         "自定义音乐包 (custom_musickit)", IDC_CK_CUSTOM_KIT,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 220, 16
    CONTROL         "启用击杀音效替换 (enable_kill_sound)", IDC_CK_ENABLE_KILL_SOUND,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 34, 250, 16
    CONTROL         "闪光叠加页面 (custom_flashbang)", IDC_CK_FLASHBANG,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 56, 220, 16
    CONTROL         "低内存模式 (low_memory)", IDC_CK_LOW_MEMORY,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 78, 220, 16
    CONTROL         "显示MVP信息板 (show_mvp)", IDC_CK_SHOW_MVP,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 100, 220, 16
    CONTROL         "使用 OGG 音频格式 (ogg)", IDC_CK_USE_OGG,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 122, 220, 16
    LTEXT           "音量 (vol):", IDC_STATIC, 12, 150, 60, 12
    EDITTEXT        IDC_EDIT_VOL, 80, 146, 60, 16, ES_LEFT
    LTEXT           "(0.0 ~ 1.0)", IDC_STATIC, 150, 150, 80, 12
    DEFPUSHBUTTON   "保存", IDOK, 200, 190, 60, 25, WS_TABSTOP
    PUSHBUTTON      "取消", IDCANCEL, 270, 190, 60, 25, WS_TABSTOP
END

IDD_QUICKSTOP_VALUE DIALOGEX 0, 0, 240, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "输入急停参数"
FONT 9, "Microsoft YaHei", 400, 0, 0x86
