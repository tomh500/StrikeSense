// 鍏充簬瀵硅瘽妗?
IDD_ABOUTBOX DIALOGEX 0, 0, 280, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "鍏充簬 StrikeSense"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDI_STRIKESENSE,IDC_STATIC,14,14,21,20
    LTEXT           "StrikeSense",IDC_STATIC,42,8,100,8,SS_NOPREFIX
    LTEXT           "Test Build 202607151750",IDC_STATIC,42,20,120,8
    LTEXT           "Copyright (C) 2026 StrikeSense",IDC_STATIC,42,32,140,8
    LTEXT           "Offline only. No update check.",IDC_STATIC,14,50,250,16
    LTEXT           "Fast | Simple | Local data only",IDC_STATIC,14,66,250,12
    DEFPUSHBUTTON   "OK",IDOK,115,88,50,14,WS_GROUP
END

// Debugger 璋冭瘯杈撳嚭绐楀彛
IDD_DEBUGGER DIALOGEX 0, 0, 480, 360
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Debugger 璋冭瘯杈撳嚭"
FONT 9, "寰蒋闆呴粦", 400, 0, 0x80
BEGIN
    EDITTEXT        IDC_DEBUG_EDIT, 8, 8, 464, 304, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "娓呴櫎", IDC_COPYALL, 380, 320, 70, 24, BS_PUSHBUTTON | WS_TABSTOP
    PUSHBUTTON      "鍏抽棴", IDOK, 8, 320, 70, 24, BS_PUSHBUTTON | WS_TABSTOP
END

// GSI 閰嶇疆璺緞纭瀵硅瘽妗?
IDD_CONFIRM_PATH DIALOGEX 0, 0, 450, 215
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "纭 GSI 閰嶇疆鏂囦欢璺緞"
FONT 9, "寰蒋闆呴粦", 400, 0, 0x80
BEGIN
    LTEXT           "CS2 cfg path:",IDC_STATIC,12,12,300,12
    EDITTEXT        IDC_PATH_LABEL,12,28,426,20, ES_READONLY | ES_AUTOHSCROLL | ES_LEFT
    LTEXT           "Install GSI config to this folder?",IDC_STATIC,12,58,300,12
    DEFPUSHBUTTON   "Yes(&Y)", IDYES, 30, 85, 90, 25, WS_TABSTOP
    PUSHBUTTON      "Browse...(&B)", IDC_BROWSE_BTN, 140, 85, 90, 25, WS_TABSTOP
    PUSHBUTTON      "Delete file(&D)", IDC_DELETE_CFG, 250, 85, 100, 25, WS_TABSTOP
    PUSHBUTTON      "Cancel(&C)", IDCANCEL, 360, 85, 70, 25, WS_TABSTOP
END

// 璁剧疆瀵硅瘽妗?
IDD_SETTINGS DIALOGEX 0, 0, 350, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "StrikeSense 璁剧疆"
FONT 9, "寰蒋闆呴粦", 400, 0, 0x80
BEGIN
    CONTROL         "鑷畾涔夐煶涔愬寘 (custom_musickit)", IDC_CK_CUSTOM_KIT,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 220, 16
    CONTROL         "鍚敤鍑绘潃闊虫晥鏇挎崲 (enable_kill_sound)", IDC_CK_ENABLE_KILL_SOUND,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 34, 250, 16
    CONTROL         "闂厜鍙犲姞椤甸潰 (custom_flashbang)", IDC_CK_FLASHBANG,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 56, 220, 16
    CONTROL         "浣庡唴瀛樻ā寮?(low_memory)", IDC_CK_LOW_MEMORY,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 78, 220, 16
    CONTROL         "鏄剧ずMVP淇℃伅鏉?(show_mvp)", IDC_CK_SHOW_MVP,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 100, 220, 16
    CONTROL         "浣跨敤 OGG 闊抽鏍煎紡 (ogg)", IDC_CK_USE_OGG,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 122, 220, 16
    LTEXT           "闊抽噺 (vol):", IDC_STATIC, 12, 150, 60, 12
    EDITTEXT        IDC_EDIT_VOL, 80, 146, 60, 16, ES_LEFT
    LTEXT           "(0.0 ~ 1.0)", IDC_STATIC, 150, 150, 80, 12
    DEFPUSHBUTTON   "淇濆瓨", IDOK, 200, 190, 60, 25, WS_TABSTOP
    PUSHBUTTON      "鍙栨秷", IDCANCEL, 270, 190, 60, 25, WS_TABSTOP
END

