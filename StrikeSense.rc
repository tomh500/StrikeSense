VS_VERSION_INFO VERSIONINFO
 FILEVERSION 202607151750
 PRODUCTVERSION 202607151750
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "StrikeSense"
            VALUE "FileDescription", "StrikeSense - CS2 GSI Client"
            VALUE "FileVersion", "Test Build 202607151750"
            VALUE "InternalName", "StrikeSense"
            VALUE "LegalCopyright", "Copyright (C) 2026 StrikeSense"
            VALUE "OriginalFilename", "StrikeSense.exe"
            VALUE "ProductName", "StrikeSense"
            VALUE "ProductVersion", "Test Build 202607151750"
            VALUE "PrivateBuild", "\nOffline only.\nFast and simple.\n"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// 鍥炬爣
//

IDI_STRIKESENSE       ICON         "StrikeSense.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// 鑿滃崟
//

IDC_STRIKESENSE MENU
BEGIN
    POPUP "鏂囦欢(&F)"
    BEGIN
        MENUITEM "鍒涘缓 GSI 閰嶇疆鏂囦欢(&G)...",  IDM_CREATE_GSI_CFG
        MENUITEM SEPARATOR
        MENUITEM "璁剧疆(&S)...",             IDM_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "閫€鍑?&X)",                IDM_EXIT
    END
    POPUP "甯姪(&H)"
    BEGIN
        MENUITEM "Debugger(&D)",            IDM_DEBUGGER
        MENUITEM SEPARATOR
        MENUITEM "鍏充簬(&A) ...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// 蹇嵎閿?
//

IDC_STRIKESENSE ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


