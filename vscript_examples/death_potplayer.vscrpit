// @name: 死后切 PotPlayer
// @provider: StrikeSense
// @version: 1.0.0
// @notice: 自己本回合首次死亡时切到 PotPlayer，不存在就启动；freezetime 自动切回游戏。
if(on:self_dead_this_round==true && self_alive==false){
    EnsureProcessWindow("PotPlayerMini64.exe", "%USERPROFILE%/AppData/Roaming/PotPlayerMini64/PotPlayerMini64.exe", true);
};

if(on:round_phase=="freezetime"){
    ShowGameProcess();
};
