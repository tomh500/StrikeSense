int i = 0;
float total = 0;
string tag = "demo";

if(on:round_phase=="live"){
    Log("回合刚进入 live");
    i = 0;
    total = 0;
};

while(i<3){
    total = total + 0.5;
    i = i + 1;
};

for(int k=0; k<2; k=k+1){
    Log("for 循环正在运行");
};

if(weapon_name=="weapon_hkp2000" && weapon_clip_delta>0){
    Log("检测到一发开火");
}else{
    Log("当前没有满足 P2000 开火条件");
};

if(!internal_in_lobby && (health>0 || death_mute==false)){
    Top("cs2.exe", true);
};

return;
